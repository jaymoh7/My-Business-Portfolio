# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB configuration
# Use Atlas or local MongoDB.
# Example Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/portfolio-db?retryWrites=true&w=majority
# Example local:
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio-db

# Email configuration (optional)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Frontend allowed origin
FRONTEND_URL=http://localhost:8080
